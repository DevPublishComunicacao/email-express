<%- include('partials/head') %>
<main class="dashboard">
<%- include('partials/dashboard-header') %>
  <section class="page-content">
    <div class="page-header">
      <h2><i class="fas fa-chart-bar"></i> Painel</h2>
      <p>Visão geral dos seus e-mails e respostas.</p>
    </div>

    <div id="newEmailsAlert" class="alert alert-success" style="display:none"><i class="fas fa-download"></i><span id="newEmailsMsg"></span></div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon stat-icon-emails"><i class="fas fa-envelope"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= totalEmails %></span>
          <span class="stat-label">E-mails</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-categories"><i class="fas fa-tags"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= totalCategories %></span>
          <span class="stat-label">Categorias</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-auto"><i class="fas fa-reply-all"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= totalAutoReplies %></span>
          <span class="stat-label">Auto-Respostas</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-sent"><i class="fas fa-paper-plane"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= totalSentReplies %></span>
          <span class="stat-label">Respostas Enviadas</span>
        </div>
      </div>
    </div>

    <div class="dashboard-grid">
      <div class="card chart-card">
        <div class="card-header">
          <h3><i class="fas fa-chart-pie"></i> E-mails por Categoria</h3>
        </div>
        <div class="card-body">
          <canvas id="chartCategory"></canvas>
        </div>
      </div>
      <div class="card">
        <div class="card-header card-header-flex">
          <h3><i class="fas fa-clock"></i> Últimas Respostas Enviadas</h3>
          <a href="/email/sent-replies" class="btn btn-sm btn-link">Ver todas</a>
        </div>
        <div class="card-body p-0">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th style="width:110px">Data</th>
                <th>De</th>
                <th>Assunto</th>
                <th style="width:60px">Tipo</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentReplies.length === 0) { %>
                <tr><td colspan="4" class="empty-cell">Nenhuma resposta enviada ainda.</td></tr>
              <% } else { %>
                <% recentReplies.forEach(function(r) { %>
                  <tr>
                    <td class="cell-date"><%= new Date(r.sentAt).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) %></td>
                    <td><%= r.email.from %></td>
                    <td><%= r.subject %></td>
                    <td><span class="badge badge-sent"><%= r.autoReply ? 'Auto' : 'Manual' %></span></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <% if (totalEmails > 0) { %>
    <div class="card" style="margin-top:20px">
      <div class="card-header">
        <h3><i class="fas fa-list"></i> Distribuição por Categoria</h3>
      </div>
      <div class="card-body p-0">
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Categoria</th>
              <th>E-mails</th>
              <th>%</th>
            </tr>
          </thead>
          <tbody>
            <% categoryDistribution.forEach(function(cat) { %>
              <tr>
                <td><%= cat.name %></td>
                <td><%= cat.count %></td>
                <td><%= cat.pct %>%</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <div class="welcome-actions" style="margin-top:24px">
      <a href="/email/config" class="btn btn-primary"><i class="fas fa-cog"></i> Configurar E-mail</a>
      <a href="/email/inbox" class="btn btn-outline"><i class="fas fa-inbox"></i> Caixa de Entrada</a>
      <a href="/email/categories" class="btn btn-outline"><i class="fas fa-tags"></i> Categorias</a>
      <% if (hasConfig) { %>
        <a href="/email/auto-replies" class="btn btn-outline"><i class="fas fa-reply-all"></i> Auto-Respostas</a>
        <a href="/email/signature" class="btn btn-outline"><i class="fas fa-signature"></i> Assinatura</a>
      <% } %>
    </div>
  </section>
</main>

<script>
(function() {
  // Check for new emails after page load
  fetch('/dashboard/check-emails', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.count > 0) {
        var alert = document.getElementById('newEmailsAlert');
        document.getElementById('newEmailsMsg').textContent = data.count + ' novo(s) e-mail(s) importado(s).';
        alert.style.display = '';
        setTimeout(function() { alert.style.display = 'none'; }, 5000);
      }
    })
    .catch(function(e) { console.error(e); });
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(function() {
  var labels = <%- chartLabels %>;
  var data = <%- chartData %>;

  var canvas = document.getElementById('chartCategory');
  if (canvas && labels && labels.length) {
    var colors = ['#1877f2','#42b72a','#f5a623','#e74c3c','#9b59b6','#1abc9c','#e67e22','#34495e'];
    try {
      new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: data,
            backgroundColor: colors.slice(0, labels.length),
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { padding: 16, usePointStyle: true }
            }
          }
        }
      });
    } catch(e) {
      console.error('Chart error:', e);
      canvas.parentNode.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:40px">Erro ao carregar gráfico.</p>';
    }
  }
})();
</script>
<%- include('partials/footer') %>