<%- include('partials/head') %>
<main class="dashboard">
<%- include('partials/dashboard-header') %>

<section class="page-content">
  <div class="page-header">
    <h2><i class="fas fa-cog"></i> Configurações de E-mail</h2>
    <p>Configure suas credenciais Gmail para que o sistema possa acessar seus e-mails.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span><%= error %></span></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><i class="fas fa-check-circle"></i><span><%= success %></span></div>
  <% } %>

  <div class="card">
    <div class="card-body">
      <div class="info-box">
        <i class="fas fa-info-circle"></i>
        <div>
          <strong>Como obter sua senha de app do Gmail:</strong>
          <ol>
            <li>Acesse sua <a href="https://myaccount.google.com/security" target="_blank">Conta Google</a> (segurança)</li>
            <li>Ative a <strong>Verificação em duas etapas</strong> se ainda não estiver ativa</li>
            <li>Acesse diretamente: <a href="https://myaccount.google.com/apppasswords" target="_blank">https://myaccount.google.com/apppasswords</a></li>
            <li>Se não encontrar, pesquise por "Senhas de app" nas configurações da sua Conta Google</li>
            <li>Selecione "E-mail" e seu dispositivo, clique em "Gerar"</li>
            <li>Copie a senha gerada (16 caracteres sem espaços) e cole abaixo</li>
          </ol>
        </div>
      </div>

      <div class="info-box" style="margin-top:16px">
        <i class="fas fa-info-circle"></i>
        <div>
          <strong>Aviso para hospedagem no Render (Free Tier):</strong>
          <p style="margin:4px 0 0">O Render <strong>bloqueia portas SMTP</strong> (587, 465) no plano gratuito desde Setembro/2025. Para enviar e-mails, você precisa <a href="https://render.com/docs/free#free-web-services" target="_blank">fazer upgrade para um plano pago</a> ou usar serviços como SendGrid.</p>
        </div>
      </div>


      <form action="/email/config" method="POST" class="email-config-form">
        <div class="form-group">
          <label for="email">Seu e-mail Gmail</label>
          <input type="email" id="email" name="email" value="<%= typeof config !== 'undefined' && config ? config.email : '' %>" placeholder="seuemail@gmail.com" required />
        </div>

        <div class="form-group">
          <label for="appPassword">Senha de App do Gmail</label>
          <div class="password-wrapper">
            <input type="password" id="appPassword" name="appPassword" value="<%= typeof config !== 'undefined' && config ? config.appPassword : '' %>" placeholder="Senha de 16 caracteres" required />
            <button type="button" class="toggle-password" aria-label="Mostrar senha">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <details class="advanced-settings">
          <summary>Configurações avançadas (IMAP/SMTP)</summary>
          <div class="advanced-grid">
            <div class="form-group">
              <label for="imapHost">IMAP Host</label>
              <input type="text" id="imapHost" name="imapHost" value="<%= typeof config !== 'undefined' && config ? config.imapHost : 'imap.gmail.com' %>" />
            </div>
            <div class="form-group">
              <label for="imapPort">IMAP Port</label>
              <input type="number" id="imapPort" name="imapPort" value="<%= typeof config !== 'undefined' && config ? config.imapPort : 993 %>" />
            </div>
            <div class="form-group">
              <label for="smtpHost">SMTP Host</label>
              <input type="text" id="smtpHost" name="smtpHost" value="<%= typeof config !== 'undefined' && config ? config.smtpHost : 'smtp.gmail.com' %>" />
            </div>
            <div class="form-group">
              <label for="smtpPort">SMTP Port</label>
              <input type="number" id="smtpPort" name="smtpPort" value="<%= typeof config !== 'undefined' && config ? config.smtpPort : 587 %>" />
            </div>
          </div>
        </details>

        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save"></i> Salvar Configurações
        </button>
      </form>
    </div>
  </div>
</section>
</main>
<%- include('partials/footer') %>
