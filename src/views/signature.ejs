<%- include('partials/head') %>
<main class="dashboard">
<%- include('partials/dashboard-header') %>

<section class="page-content">
  <div class="page-header">
    <h2><i class="fas fa-pen"></i> Assinatura de E-mail</h2>
    <p>Configure sua assinatura que será inserida ao final de todas as respostas automáticas.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span><%= error %></span></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><i class="fas fa-check-circle"></i><span><%= success %></span></div>
  <% } %>

  <div class="card">
    <div class="card-body">
      <form action="/email/signature" method="POST" id="signatureForm">
        <div class="form-group">
          <label>Assinatura</label>
          <div class="editor-toolbar">
            <button type="button" class="editor-btn" data-cmd="bold" title="Negrito"><i class="fas fa-bold"></i></button>
            <button type="button" class="editor-btn" data-cmd="italic" title="Itálico"><i class="fas fa-italic"></i></button>
            <button type="button" class="editor-btn" data-cmd="underline" title="Sublinhado"><i class="fas fa-underline"></i></button>
            <span class="editor-sep">|</span>
            <button type="button" class="editor-btn" data-cmd="insertUnorderedList" title="Lista"><i class="fas fa-list-ul"></i></button>
            <button type="button" class="editor-btn" data-cmd="insertOrderedList" title="Lista numerada"><i class="fas fa-list-ol"></i></button>
            <span class="editor-sep">|</span>
            <button type="button" class="editor-btn editor-btn-image" title="Inserir imagem"><i class="fas fa-image"></i></button>
          </div>
          <div class="auto-reply-editor" id="signatureEditor" contenteditable="true" data-placeholder="Digite sua assinatura..."><%- typeof signature !== 'undefined' && signature ? signature : '' %></div>
          <input type="hidden" name="signature" id="signatureHidden" />
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Salvar Assinatura</button>
      </form>
    </div>
  </div>
</section>

<input type="file" id="imageInput" accept="image/*" style="display:none" />

<script>
(function() {
  document.querySelectorAll('.editor-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (this.classList.contains('editor-btn-image')) {
        document.getElementById('imageInput').click();
        return;
      }
      var cmd = this.dataset.cmd;
      document.execCommand(cmd, false, null);
      var editor = document.getElementById('signatureEditor');
      if (editor) editor.focus();
    });
  });

  document.getElementById('imageInput').addEventListener('change', async function() {
    if (!this.files || !this.files[0]) return;
    var formData = new FormData();
    formData.append('image', this.files[0]);
    try {
      var res = await fetch('/email/upload-image', { method: 'POST', body: formData });
      var data = await res.json();
      if (data.url) {
        document.execCommand('insertImage', false, data.url);
        var editor = document.getElementById('signatureEditor');
        var img = editor?.querySelector('img:last-child');
        if (img) {
          img.style.maxWidth = '100%';
          img.style.height = 'auto';
          var wrapper = document.createElement('div');
          wrapper.style.display = 'inline-block';
          wrapper.style.resize = 'both';
          wrapper.style.overflow = 'hidden';
          wrapper.style.maxWidth = '100%';
          img.parentNode.insertBefore(wrapper, img);
          wrapper.appendChild(img);
        }
      } else {
        alert(data.error || 'Erro ao enviar imagem.');
      }
    } catch (e) {
      alert('Erro de conexão.');
    }
    this.value = '';
  });

  document.getElementById('signatureForm').addEventListener('submit', function() {
    var editor = document.getElementById('signatureEditor');
    var hidden = document.getElementById('signatureHidden');
    if (editor && hidden) hidden.value = editor.innerHTML;
  });
})();
</script>

<%- include('partials/footer') %>
